# ==============================================================================
# 🛡️ AETHELGARD: CONFIGURATION TEMPLATE
# Zero-cost, local-first AI Site Reliability Engineer (AI-SRE)
# ==============================================================================

# Target Microservice Telemetry
TARGET_SERVICE_URL=http://127.0.0.1:8000/health
TARGET_SERVICE_METRICS_URL=http://127.0.0.1:8000/metrics

# Sentinel Anomaly Detection Knobs
SENTINEL_WINDOW_SIZE=20
SENTINEL_Z_SCORE_THRESHOLD=3.0
SENTINEL_POLL_INTERVAL_SECONDS=1.0

# Local AI Architect Configuration (Zero-Cost Local Inference)
# Point to your local Ollama instance (default: http://localhost:11434/api/generate)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:7b

# Alternative Zero-Cost Cloud Provider (Optional: if no local GPU is available)
# Leave blank to use Ollama locally. If provided, can use Gemini free-tier (15 RPM / 1M TPM free)
GEMINI_API_KEY=

# Sandbox Verification
SANDBOX_DOCKER_IMAGE=aethelgard-sandbox:latest
SANDBOX_BASE_PORT=8080
SANDBOX_MAX_RETRIES=5

# Orchestrator Workflow Settings
ORCHESTRATOR_DAEMON_MODE=false
ORCHESTRATOR_POLL_INTERVAL=5
ENABLE_GIT_BRANCHING=true
GIT_BRANCH_PREFIX=aethelgard/remediation-

# Webhook Ingestion Gateway
WEBHOOK_GATEWAY_HOST=0.0.0.0
WEBHOOK_GATEWAY_PORT=8001

